{
  "schema": "tuned-common/upstream-vs-tuned-versions/1",
  "as_of": "2026-10-11",
  "purpose": "Reference snapshot of how each tracked upstream versions and tags its releases, side by side with what our tuned release would be named under the date scheme. Kept for form and structure: copy the shape, regenerate the values.",
  "status": "SNAPSHOT. Every tuned.expected block is SIMULATED (simulated=true): nothing here was published. The upstream facts were read on the as_of date and go stale quickly.",
  "scheme": {
    "wheel_label": "<public version>+<variant>.cu<cuda>.<YYYYMMDD>[.<seq>]",
    "wheel_example": "2.15.0+gb10.cu134.20260922",
    "native_tag": "v0.<YYYYMMDD>.<seq>-<variant>-cu<cuda>  (seq 0 is written in full on tags, omitted on wheel labels)",
    "label_date_source": "committer date (UTC) of the tuned HEAD commit, so rebuilding a commit reproduces its label; most repos' HEAD is from 2026-09-22",
    "reference": "docs/VERSIONING.md"
  },
  "provenance": {
    "verified": "read from GitHub API, git ls-remote and git show at the base commit on the as_of date (see method)",
    "inferred": [
      "base.nearest_tag_* where nearest_tag_reliability is 'unverified'",
      "tag_lineage derived from the GitHub compare ahead/behind counts against the default branch (behind>0 means the newest stable tag is not an ancestor of the default branch)"
    ],
    "simulated": "all tuned.expected fields",
    "unpublished_assumptions": [
      "wheel public versions are taken from the last published build; the next build recomputes them",
      "llama.cpp expected tag would not match install.sh's current regex ^v[0-9]+-<variant>-cu[0-9]+$"
    ]
  },
  "method": [
    "gh api repos/<upstream>/releases?per_page=100   (newest releases, prerelease flags)",
    "gh api repos/<upstream>/compare/<newest-stable-tag>...<default-branch>   (status, ahead_by, behind_by)",
    "git -C <repo> ls-remote --tags upstream   (all upstream tags; filtered with the stable_tag_regexes)",
    "git -C <repo> merge-base HEAD <tracked_ref>   (base sha); git -C <repo> show <base>:<file>   (declared version)",
    "GPU_TUNED_UPSTREAM_REF=<ref> gpu_tuned_git_provenance   (stamp: base sha and nearest tag)",
    "gh release list --repo <fork> --limit 1   (latest published tuned tag)",
    "gpu_tuned_local_version_dated gb10 <cuda> <YYYYMMDD> 0   (expected wheel label)"
  ],
  "known_corrections": [
    "2026-10-11: raft's newest upstream tag is v26.10.00, not the v26.08.00 GitHub release an earlier table showed",
    "2026-10-11: llama.cpp's source at our base declares 0.5.0; 'nearest tag' (v0.4.1+227) is a tag-topology artifact"
  ],
